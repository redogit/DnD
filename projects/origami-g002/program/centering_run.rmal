# One bounded run. Frames keep complete sampled values and immutable input
# note references. Home is frame 0; source paths may dip inside the core circle.
# Every transition, parent choice, interpolation and composition executes here.
fn centering_run_trace(seq, op, accepted, reason, phase, active, frontier, retained, attempted_q, attempted_note, homeward_requested) {
  emit("{\"seq\":"); emit(seq);
  emit(",\"op\":"); emit(quote(op));
  emit(",\"accepted\":"); emit(accepted);
  emit(",\"reason\":");
  if accepted { emit(nil); } else { emit(quote(reason)); }
  emit(",\"phase\":"); emit(quote(phase));
  emit(",\"atHome\":"); emit(active <= 0);
  emit(",\"activeFrameId\":"); emit(active);
  emit(",\"frontierFrameId\":"); emit(frontier);
  emit(",\"retainedCount\":"); emit(retained);
  emit(",\"attemptedQ\":");
  if op == "advance" { emit(attempted_q); } else { emit(nil); }
  emit(",\"attemptedNote\":");
  if op == "advance" { emit(quote(attempted_note)); } else { emit(nil); }
  emit(",\"homewardRequested\":"); emit(homeward_requested); emit("}");
  return nil;
}
fn run_centre_run() {
  let operation_count = length("operations");
  let values = buffer_new((operation_count + 1) * 86);
  # Metadata stride 3: q, parent frame, note's source operation index.
  let metadata = buffer_new((operation_count + 1) * 3);
  let retained = 1;
  let active = 0;
  let frontier = 0;
  let phase = "exploring";
  let i = 0;
  let row = "";
  let op = "";
  let accepted = true;
  let reason = "";
  let attempted_q = 0.0;
  let attempted_note = "";
  let homeward_requested = false;
  buffer_set(metadata, 0, 1);
  centering_sample(values, 0, 1.0);
  emit("{\"schema\":\"origami-centering-run-v1\",\"runId\":"); emit(quote(text("runId")));
  emit(",\"homeFrameId\":0");
  centering_emit_core();
  emit(",\"trace\":[");
  centering_run_trace(0, "start", true, "", phase, active, frontier, retained, 0.0, "", false);
  while i < operation_count {
    SET row = "operations." + i;
    SET op = text(row + ".op");
    SET accepted = true;
    SET reason = "";
    SET attempted_q = 0.0;
    SET attempted_note = "";
    SET homeward_requested = op == "homeward";
    if op == "advance" {
      SET attempted_q = number(row + ".q");
      SET attempted_note = text(row + ".note");
      if has(row + ".homeward") { SET homeward_requested = boolean(row + ".homeward"); }
    }
    # The priority signal changes phase before a competing advance is judged.
    if homeward_requested {
      if active <= 0 { SET phase = "home"; } else { SET phase = "returning"; }
    }
    if op == "advance" {
      if homeward_requested {
        SET accepted = false;
        SET reason = "homeward_override";
      } else {
        if phase != "exploring" {
          SET accepted = false;
          SET reason = "exploration_held";
        } else {
          if attempted_q >= buffer_get(metadata, active * 3) {
            SET accepted = false;
            SET reason = "not_outward";
          } else {
            buffer_set(metadata, retained * 3, attempted_q);
            buffer_set(metadata, retained * 3 + 1, active);
            buffer_set(metadata, retained * 3 + 2, i);
            centering_sample(values, retained * 86, attempted_q);
            SET active = retained;
            SET frontier = retained;
            SET retained = retained + 1;
          }
        }
      }
    }
    if op == "return_step" {
      if phase == "exploring" {
        SET accepted = false;
        SET reason = "homeward_required";
      } else {
        if active > 0 {
          # Follow exactly one stored parent; never sample or invert on return.
          SET active = buffer_get(metadata, active * 3 + 1);
          if active <= 0 { SET phase = "home"; }
        }
      }
    }
    emit(",");
    centering_run_trace(i + 1, op, accepted, reason, phase, active, frontier, retained, attempted_q, attempted_note, homeward_requested);
    SET i = i + 1;
  }
  emit("],\"frames\":[");
  SET i = 0;
  while i < retained {
    if i > 0 { emit(","); }
    emit("{\"id\":"); emit(i);
    emit(",\"parentId\":");
    if i == 0 { emit(nil); } else { emit(buffer_get(metadata, i * 3 + 1)); }
    emit(",\"q\":"); emit(buffer_get(metadata, i * 3));
    emit(",\"note\":");
    if i == 0 { emit(quote("")); } else { emit(quote(text("operations." + buffer_get(metadata, i * 3 + 2) + ".note"))); }
    centering_emit_values(values, i * 86);
    emit("}");
    SET i = i + 1;
  }
  emit("],\"activeFrameId\":"); emit(active);
  emit(",\"frontierFrameId\":"); emit(frontier);
  emit(",\"phase\":"); emit(quote(phase));
  emit(",\"atHome\":"); emit(active <= 0); emit("}");
  return nil;
}
