MODULE crack_all.naming_universe
EXPORT registry_name,registry_version,total_names,total_families,total_origins
SURFACE canonical
TARGET object

# CRACK ALL IN MY LANGUAGE — source-bounded naming universe
CONST registry_name = "CRACK_ALL_IN_MY_LANGUAGE"
CONST registry_version = "1.0.0"
CONST total_names = 299
CONST total_families = 38
CONST total_origins = 7

ENTITY CrackAll.Registry KIND REGISTRY NAME "Crack All — Coined Name Universe" STATUS ACTIVE ORIGIN USER-DIRECTED SCOPE "RecoveredCorpus" AUTHORITY NONE PROVENANCE "MASTER_COINED_NAME_REGISTRY_RECOVERED_PASS4_WIDER_DEEPER.json"
ENTITY CrackAll.DecisionField KIND DECISION_FIELD NAME "Name Resolution Decision Field" STATUS ACTIVE ORIGIN USER-DIRECTED SCOPE "RecoveredCorpus" AUTHORITY NONE PROVENANCE "current task"
ENTITY CrackAll.Morphology KIND MORPHOLOGY_INDEX NAME "User Language Morphology Index" STATUS ACTIVE ORIGIN USER-DIRECTED SCOPE "RecoveredCorpus" AUTHORITY NONE PROVENANCE "current task"
ENTITY CrackAll.Unresolved KIND REMAINDER NAME "Unresolved Name References" STATUS ACTIVE ORIGIN COMPUTED SCOPE "RecoveredCorpus" AUTHORITY NONE PROVENANCE "current task"

ATTRIBUTE CrackAll.Registry KEY TARGET VALUE "all recovered coined names / aliases / operators / project labels / signature phrases"
ATTRIBUTE CrackAll.Registry KEY GOAL VALUE "make every recovered name reachable through exact literal, provenance, family, origin, cross-reference, and bounded morphology"
ATTRIBUTE CrackAll.Registry KEY PRESERVE VALUE "literal wording; attribution; history; non-equivalence; claim ceilings; unresolved remainder"
ATTRIBUTE CrackAll.Registry KEY ALLOW VALUE "observe; distinguish; relate; rotate representation; compose references; reconstruct lineage; counter-check"
ATTRIBUTE CrackAll.Registry KEY FORBID VALUE "semantic-similarity identity merge; evidence transfer; authority transfer; invention of missing provenance"
ATTRIBUTE CrackAll.Registry KEY SUCCESS VALUE "every recovered entry represented or explicitly unresolved"
ATTRIBUTE CrackAll.Registry KEY EVIDENCE VALUE "source-bounded corpus evidence; no worldwide novelty claim"

BOUNDARY CrackAll.Registry CLAIM_CEILING CORPUS_ORIGIN_ONLY REASON "registry records recovered corpus naming and authorship; it does not establish worldwide novelty, trademark priority, patent novelty, or scientific truth"
BOUNDARY CrackAll.Morphology CLAIM_CEILING INDEX_ONLY REASON "shared token or morphology is a retrieval clue, not semantic identity or evidence transfer"
BOUNDARY CrackAll.DecisionField CLAIM_CEILING RESOLUTION_ONLY REASON "resolver may return related candidates but may not manufacture identity, authority, or truth"

