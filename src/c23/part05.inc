char*rmal_manifest(const RmalBytecode*b,bool json){Str s={0};if(!json){str_appendf(&s,"RMAL-MANIFEST module=%s source=%s\nfunctions=%zu\ndirectives=%zu\n",b->module,b->source_name,b->func_count,b->dir_count);for(size_t i=0;i<b->dir_count;i++)str_appendf(&s,"directive @%d:%d %s :: %s\n",b->directives[i].line,b->directives[i].column,b->directives[i].name,b->directives[i].payload);return s.data;}
    str_appendf(&s,"{\n  \"schema\": \"rmal/manifest/v1\",\n  \"module\": ");json_escape(&s,b->module);str_appendf(&s,",\n  \"source\": ");json_escape(&s,b->source_name);str_appendf(&s,",\n  \"functions\": %zu,\n  \"directives\": [\n",b->func_count);for(size_t i=0;i<b->dir_count;i++){Directive*d=&b->directives[i];str_appendf(&s,"    {\"name\": ");json_escape(&s,d->name);str_appendf(&s,", \"payload\": ");json_escape(&s,d->payload);str_appendf(&s,", \"line\": %d, \"column\": %d}%s\n",d->line,d->column,i+1<b->dir_count?",":"");}str_appendf(&s,"  ]\n}\n");return s.data;}

char*rmal_audit(const RmalProgram*p,const RmalBytecode*b){Str s={0};str_appendf(&s,"AUDIT PASS\nsource=%s\nmodule=%s\nstatements=%zu\nbytecode=%zu\nfunctions=%zu\ndirectives=%zu\n",p->source_name,p->module,p->count,b->main_code.count,b->func_count,b->dir_count);str_appendf(&s,"PARSED != EXECUTED\nAUDIT_PASS != SEMANTIC_TRUTH\nTRACE != PROOF\n");return s.data;}

char*rmal_language_spec(bool json){if(json)return xstrdup("{\n  \"schema\": \"rmal/language-contract/v3.1\",\n  \"language\": \"RMAL\",\n  \"compiler\": \"RMALC\",\n  \"implementation\": \"ISO C23\",\n  \"windows_target\": \"x86_64-pc-windows-msvc via Clang\",\n  \"pipeline\": [\"lexer\",\"parser\",\"AST\",\"RMALBC1\",\"VM\",\"manifest\",\"trace\",\"audit\"],\n  \"boundaries\": [\"PARSED != EXECUTED\",\"COMPILED != SCIENTIFICALLY_VALID\",\"TRACE != PROOF\"]\n}\n");return xstrdup("RMAL 3.1 / RMALC 3.1\nimplementation: ISO C23\nprimary Windows compiler: Clang -std=c23\ncurrent pipeline: source -> lexer -> parser -> AST -> RMALBC1 -> VM -> manifest/trace/audit\nboundary: PARSED != EXECUTED; COMPILED != SCIENTIFICALLY_VALID; TRACE != PROOF\n");}

bool rmal_selfcheck(char**report){const char*src="MODULE selfcheck;\nCONST answer = 42;\nSTATE counter = 1;\nSET counter = counter + 1;\nREQUIRE counter == 2;\nfn fact(n) { if n <= 1 { return 1; } else { return n * fact(n - 1); } }\nREQUIRE fact(5) == 120;\nCONTEXT NativeC23 authority=LOCAL evidence_transfer=DENY\nVERIFY \"C23 parser compiler vm\";\nCONTINUE;\n";RmalStatus st={0};RmalProgram*p=rmal_parse_source(src,"<selfcheck>",&st);if(!p){if(report)*report=xstrdup(st.message);return false;}RmalBytecode*b=rmal_compile(p,&st);if(!b){if(report)*report=xstrdup(st.message);rmal_program_free(p);return false;}RmalVm*vm=rmal_vm_create();RmalValue rv=value_nil();st=rmal_vm_run(vm,b,true,&rv);rmal_value_free(&rv);if(report){char*a=rmal_audit(p,b);Str s={0};str_appendf(&s,"%strace=%zu\n",a?a:"",rmal_vm_trace_count(vm));free(a);*report=s.data;}bool ok=st.ok;rmal_vm_free(vm);rmal_bytecode_free(b);rmal_program_free(p);return ok;}
