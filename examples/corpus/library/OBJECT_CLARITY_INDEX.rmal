CONTEXT OBJ_0529 name="Boolean Resonance Lattice / BRL" kind="FAMILY" scope="CodeAtlas" status="RECOVERED" authority="NONE" origin="RECOVERED" source="CODE_ATLAS_2026-09-19_20_v2(1).json" provenance="CODE_ATLAS_2026-09-19_20_v2(1).json" clarity="What native lineage does this family own, what may its methods share sideways, and which evidence must remain domain-local?" evidence_class="RECOVERED_CODE_ATLAS" claim_ceiling="64-byte sketch identity is not source-concept identity | sidecar reconstruction remains distinct from sketch similarity | portable/COFF/ELF evidence does not establish Microsoft ml64 runtime behavior" unresolved="" provenance_present="1" claim_ceiling_present="1" recovery_path_present="1" canonical_restore_verified="1" consequential_ambiguity="0" human_clarity_adjudicated="0"
CONTEXT OBJ_0530 name="FDE Creativity Integration" kind="FAMILY" scope="CodeAtlas" status="RECOVERED" authority="NONE" origin="RECOVERED" source="CODE_ATLAS_2026-09-19_20_v2(1).json" provenance="CODE_ATLAS_2026-09-19_20_v2(1).json" clarity="What native lineage does this family own, what may its methods share sideways, and which evidence must remain domain-local?" evidence_class="RECOVERED_CODE_ATLAS" claim_ceiling="integration records relation and provenance rather than truth promotion | patch/registry artifacts are separate from executable verification" unresolved="" provenance_present="1" claim_ceiling_present="1" recovery_path_present="1" canonical_restore_verified="1" consequential_ambiguity="0" human_clarity_adjudicated="0"
CONTEXT OBJ_0531 name="Decision-State Model / Hodge / P vs NP Local Comparison" kind="FAMILY" scope="CodeAtlas" status="RECOVERED" authority="NONE" origin="RECOVERED" source="CODE_ATLAS_2026-09-19_20_v2(1).json" provenance="CODE_ATLAS_2026-09-19_20_v2(1).json" clarity="What native lineage does this family own, what may its methods share sideways, and which evidence must remain domain-local?" evidence_class="RECOVERED_CODE_ATLAS" claim_ceiling="shared method does not transfer mathematical evidence | finite regression fixtures do not establish Hodge or P=NP resolution | local parity is not whole-repository parity" unresolved="" provenance_present="1" claim_ceiling_present="1" recovery_path_present="1" canonical_restore_verified="1" consequential_ambiguity="0" human_clarity_adjudicated="0"
CONTEXT OBJ_0532 name="Decision-State Stress-Test Runtime" kind="FAMILY" scope="CodeAtlas" status="RECOVERED" authority="NONE" origin="RECOVERED" source="CODE_ATLAS_2026-09-19_20_v2(1).json" provenance="CODE_ATLAS_2026-09-19_20_v2(1).json" clarity="What native lineage does this family own, what may its methods share sideways, and which evidence must remain domain-local?" evidence_class="RECOVERED_CODE_ATLAS" claim_ceiling="shared methods do not transfer evidence authority | cross-domain probes are rejected | remainder shrinks only with explicit new evidence and named resolution witness | failures are append-preserved | fitter topology changes cannot strengthen evidence | BRL sketch equality cannot merge object identity | counterprobe result is not theorem or scientific promotion" unresolved="" provenance_present="1" claim_ceiling_present="1" recovery_path_present="1" canonical_restore_verified="1" consequential_ambiguity="0" human_clarity_adjudicated="0"
