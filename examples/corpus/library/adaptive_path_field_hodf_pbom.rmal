# ADAPTIVE CONCENTRIC PATH FIELD — RMAL 2.1.2
# Transpiled from the concentric 3D adaptive binary path-builder concept.
# Base authority: RMAL / RMALC 2.1.2.
# Query overlay: RMAL LINQ milestone candidate, AUTHORITY NONE.
# SIMD lowering: capability-gated candidate; no false AVX2/AVX-512 implementation claim.

LANGUAGE AdaptiveConcentricPathFieldRMAL SURFACES canonical,user-native BACKENDS object,bytecode,ir-json,human
MODULE adaptive_concentric_path_field
DOMAIN decision-fields

# ---------------------------------------------------------------------------
# AUTHORITY / OBLIGATION / TARGET
# ---------------------------------------------------------------------------
CONTEXT SYSTEM_PURPOSE role="search_problem_solvability_and_search_complexity"
CONTEXT RMAL_TOOLCHAIN_INVARIANT role="CURRENT_EXECUTABLE_AUTHORITY" version="2.1.2"
CONTEXT TARGET_ROOT role="ADAPTIVE_ALGORITHMIC_PATH_BUILDER" scope="binary_path_search_with_reconstructible_complexity_observation"
CONTEXT EXECUTION_MODEL geometry="concentric_3d_fields_around_processing_core" flow="inward_outward_and_around_center"

PRESERVE ObjectIdentity
PRESERVE QueryIdentity
PRESERVE PathIdentity
PRESERVE ProblemSemantics
PRESERVE ConstraintScope
PRESERVE Provenance
PRESERVE Chronology
PRESERVE FailureHistory
PRESERVE EvidenceAuthorityBoundary
PRESERVE Reconstructibility
PRESERVE UnresolvedRemainder
PRESERVE Privacy
PRESERVE Clarity

# Hard evidence / execution boundaries.
RULE B01 IF "a path is generated" THEN "do not promote generation to verification"
RULE B02 IF "a branch executes successfully" THEN "do not promote execution to admission"
RULE B03 IF "a runtime restriction is observed" THEN "record it as an observed constraint until its scope is verified"
RULE B04 IF "two representations have a small XOR distance" THEN "do not infer semantic similarity unless the encoding contract supports that inference"
RULE B05 IF "execution coordinates change" THEN "preserve query identity, path identity, problem semantics, authority, provenance, and evidence boundary"
RULE B06 IF "parallel or vector execution is unavailable" THEN "fall back without changing logical query semantics"
RULE B07 IF "two paths reach the same canonical logical state" THEN "merge state work while preserving both path provenances"
RULE B08 IF "a search budget is exhausted" THEN "return unresolved or bounded result; do not report optimality or impossibility"
RULE B09 IF "a failed branch yields a reusable conflict" THEN "retain the failure and its scope as negative evidence"
RULE B10 IF "a representation transform fails its invariant check" THEN "reject that transform without rejecting the underlying problem object"

# ---------------------------------------------------------------------------
# HODF / PROOF BOM / DEMAND-LOADED CAPABILITY ROUTING
# ---------------------------------------------------------------------------
CONTEXT HODF role="HUMAN_CENTRIC_OBLIGATION_ENGINE" primitive="OBLIGATION_DRIVEN_FACTORIZATION" authority="ROUTING_AND_STRUCTURE_ONLY"
CONTEXT ProofAnatomy roles="axioms,premises,deductions,conclusion" conclusion_controls_relevance=true
CONTEXT ProofDispatch policy="FRONTIER_ONLY_DEMAND_LOAD" parallel="INDEPENDENT_FRONTIER_NODES_SIDE_TO_SIDE" reconcile="CENTRAL_EVIDENCE_LEDGER"
CONTEXT ProviderResolution order="builtin,connected_specialist,smallest_sufficient_coalition,discover_uncovered,human_connect,unresolved" discovery="COLD_PATH_ONLY"
CONTEXT ProofLifecycleCost components="prepare,factor,pbom,registry,route,data_lift,provider_execution,reconcile,verify,reconstruct,report" accounting="FULL_PATH"

TYPE HumanContext BASE Value
TYPE HumanNeed BASE Value
TYPE HumanAuthority BASE Value
TYPE HumanObligation BASE Value
TYPE DataScope BASE Value
TYPE ProofBOM BASE Value
TYPE ProofNode BASE Value
TYPE ProofAxiom BASE Value
TYPE ProofPremise BASE Value
TYPE ProofDeduction BASE Value
TYPE ProofConclusion BASE Value
TYPE ProofFrontier BASE Value
TYPE ProofPathState BASE Value
TYPE CapabilityRequirement BASE Value
TYPE CapabilityRegistry BASE Value
TYPE Provider BASE Value
TYPE ProviderCoalition BASE Value
TYPE ProviderRoute BASE Value
TYPE EvidencePacket BASE Value
TYPE AdmissionState BASE Value
TYPE HumanResult BASE Value

PRESERVE HumanPurpose
PRESERVE HumanAuthority
PRESERVE HumanCorrectionPath
PRESERVE HumanStopRollback
PRESERVE MinimumNecessaryData
PRESERVE ProofNodeIdentity
PRESERVE ProofDependencyGraph
PRESERVE EvidenceClass
PRESERVE ClaimCeiling
PRESERVE ProviderRouteIdentity
PRESERVE RouteScore != EvidenceWeight
PRESERVE ProviderSuccess != ProofNodeEstablished
PRESERVE ProofBOMItem != EvidencePacket
PRESERVE AvailableData != PermittedData
PRESERVE PermittedData != NecessaryData
PRESERVE NecessaryData != SufficientEvidence

RELATION ObligationServesHuman ALLOW HumanObligation HumanContext DENY authority_transfer
RELATION NeedCreatesObligation ALLOW HumanNeed HumanObligation DENY truth_promotion
RELATION ProofRequires ALLOW ProofNode ProofNode DENY evidence_transfer
RELATION ProofDischarges ALLOW ProofNode HumanObligation DENY claim_promotion
RELATION CapabilityRequiredBy ALLOW CapabilityRequirement ProofNode DENY evidence_transfer
RELATION ProviderCovers ALLOW Provider CapabilityRequirement DENY authority_transfer
RELATION ProviderRoutesTo ALLOW ProviderRoute ProofNode DENY evidence_transfer
RELATION EvidenceBindsTo ALLOW EvidencePacket ProofNode DENY authority_transfer
RELATION EvidenceSupports ALLOW EvidencePacket ProofNode DENY proof_promotion
RELATION DeductionDerives ALLOW ProofDeduction ProofNode DENY truth_promotion
RELATION ConclusionAnswers ALLOW ProofConclusion HumanObligation DENY authority_transfer

RULE H01 IF "data is available" THEN "do not access it unless it is permitted and can change the human obligation"
RULE H02 IF "an obligation is complex" THEN "factor the obligation before factoring the search space"
RULE H03 IF "a proof-directed obligation is active" THEN "compile exactly axioms, premises, deductions, and conclusion before provider routing"
RULE H04 IF "a proof node cannot reach the final conclusion" THEN "exclude it from proof-critical routing unless it is an explicit counterprobe"
RULE H05 IF "a proof node is not in the current conclusion-reachable frontier" THEN "defer its provider capabilities and do not pay startup or data-lift cost"
RULE H06 IF "frontier nodes are dependency-independent" THEN "dispatch them side to side and reconcile typed evidence centrally"
RULE H07 IF "a required capability is already covered by an available builtin or connected specialist" THEN "do not search the plugin directory"
RULE H08 IF "a required capability remains uncovered" THEN "discover or connect only for that capability; otherwise preserve it as unresolved remainder"
RULE H09 IF "a provider is selected" THEN "send only proof-node-local permitted data, evidence class, claim ceiling, stop condition, and return schema"
RULE H10 IF "a provider returns successfully" THEN "bind the result to the exact proof node and verify its evidence class before changing proof status"
RULE H11 IF "several providers agree" THEN "do not transfer evidence authority unless independence and the composition relation are established"
RULE H12 IF "all proof ancestors are established" THEN "validate each deduction edge before admitting the conclusion"
RULE H13 IF "the conclusion is not established" THEN "return the strongest safe partial result plus the exact missing node or edge"
RULE H14 IF "routing appears faster" THEN "charge PBOM construction, discovery, data lift, execution, reconciliation, verification, reconstruction, and reporting before claiming a speedup"

OPERATOR CrystallizeHumanObligation BIND HumanObligation INPUT HumanContext HumanNeed HumanAuthority OUTPUT HumanObligation EFFECT analyze AUTHORITY user PRESERVE purpose authority claim_ceiling correction_path
OPERATOR SieveMinimumNecessaryData BIND DataScope INPUT HumanObligation DataScope OUTPUT DataScope EFFECT analyze AUTHORITY none PRESERVE permission necessity exclusion provenance privacy
OPERATOR CompileProofBOM BIND ProofBOM INPUT HumanObligation DataScope ConstraintSet OUTPUT ProofBOM EFFECT analyze AUTHORITY none PRESERVE proof_anatomy dependency_graph claim_ceiling provenance remainder
OPERATOR ComputeProofFrontier BIND ProofFrontier INPUT ProofBOM EvidencePacket OUTPUT ProofFrontier EFFECT route AUTHORITY none PRESERVE conclusion_reachability dependency_graph proof_node_identity claim_ceiling
OPERATOR DeriveCapabilityRequirements BIND CapabilityRequirement INPUT ProofFrontier ProofBOM OUTPUT CapabilityRequirement EFFECT analyze AUTHORITY none PRESERVE proof_node_identity evidence_class access_mode claim_ceiling
OPERATOR ResolveWarmCapabilityRegistry BIND CapabilityRegistry INPUT CapabilityRequirement OUTPUT CapabilityRegistry EFFECT route AUTHORITY none PRESERVE provider_identity connection_state permissions provenance
OPERATOR SelectProviderCoalition BIND ProviderCoalition INPUT ProofFrontier CapabilityRequirement CapabilityRegistry OUTPUT ProviderCoalition EFFECT route AUTHORITY none PRESERVE proof_node_identity evidence_class claim_ceiling provider_identity
OPERATOR DispatchProofFrontier BIND ExecutionTrace INPUT ProofFrontier ProviderCoalition DataScope OUTPUT ExecutionTrace EFFECT execute AUTHORITY none PRESERVE proof_node_identity factor_scope allowed_data claim_ceiling provenance
OPERATOR BindProviderEvidence BIND EvidencePacket INPUT ExecutionTrace ProofFrontier OUTPUT EvidencePacket EFFECT state AUTHORITY none PRESERVE provider_identity proof_node_identity evidence_class provenance limits
OPERATOR VerifyProofNode BIND EvidenceReceipt INPUT ProofNode EvidencePacket ProofBOM OUTPUT EvidenceReceipt EFFECT verify AUTHORITY none PRESERVE proof_node_identity evidence_class dependency_graph claim_ceiling provenance
OPERATOR AdvanceProofFrontier BIND ProofFrontier INPUT ProofBOM EvidenceReceipt OUTPUT ProofFrontier EFFECT route AUTHORITY none PRESERVE dependency_graph proof_node_identity remainder
OPERATOR MaterializeProofPathState BIND ProofPathState INPUT ProofFrontier ProviderCoalition ProofBOM OUTPUT ProofPathState EFFECT state AUTHORITY none PRESERVE proof_node_identity path_identity provider_identity claim_ceiling provenance remainder
OPERATOR AuditProofRouteComplexity BIND ComplexityVector INPUT ProofBOM ProviderCoalition ExecutionTrace OUTPUT ComplexityVector EFFECT analyze AUTHORITY none PRESERVE full_lifecycle_cost proof_node_identity provenance
OPERATOR AdmitProofConclusion BIND HumanResult INPUT ProofConclusion ProofBOM EvidenceReceipt OUTPUT HumanResult EFFECT admit AUTHORITY user PRESERVE exact_conclusion proof_dependencies claim_ceiling uncertainty provenance remainder
OPERATOR ReturnHumanRemainder BIND HumanResult INPUT HumanObligation ProofBOM ProofFrontier EvidenceReceipt OUTPUT HumanResult EFFECT reconstruction AUTHORITY none PRESERVE human_purpose uncertainty correction_path stop_rollback remainder provenance

OPERATOR SeedPathFromProofFrontier BIND SearchFrontier INPUT ProofFrontier ProofBOM OUTPUT SearchFrontier EFFECT route AUTHORITY none PRESERVE proof_node_identity dependency_graph path_identity provenance
OPERATOR ScoreProofFrontierNode BIND ComplexityVector INPUT ProofFrontier CapabilityRegistry ExecutionTrace OUTPUT ComplexityVector EFFECT analyze AUTHORITY none PRESERVE proof_node_identity evidence_class claim_ceiling full_lifecycle_cost provenance
OPERATOR ChooseProofPathBit BIND PathBit INPUT ProofFrontier ComplexityVector OUTPUT PathBit EFFECT route AUTHORITY none PRESERVE proof_node_identity path_identity claim_ceiling provenance
OPERATOR RouteProofCapability BIND ProviderRoute INPUT ProofNode CapabilityRegistry OUTPUT ProviderRoute EFFECT route AUTHORITY none PRESERVE proof_node_identity evidence_class provider_identity permissions claim_ceiling
OPERATOR ReconcileProofEvidence BIND CoreState INPUT CoreState EvidencePacket ProofBOM OUTPUT CoreState EFFECT state AUTHORITY none PRESERVE proof_node_identity dependency_graph evidence_boundary failure_history remainder provenance

# ---------------------------------------------------------------------------
# CONCENTRIC 3D OPERATIONAL LAYERS
# ---------------------------------------------------------------------------
TYPE CoreState BASE Value
TYPE PathState BASE Value
TYPE PathBit BASE Value
TYPE PathNode BASE Value
TYPE ProblemState BASE Value
TYPE WorkingState BASE Value
TYPE TransformState BASE Value
TYPE RouteState BASE Value
TYPE BoundaryState BASE Value
TYPE Constraint BASE Value
TYPE ConstraintSet BASE Value
TYPE CandidateSet BASE Value
TYPE SearchFrontier BASE Value
