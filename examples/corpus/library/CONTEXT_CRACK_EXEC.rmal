# CRACK ALL IN MY LANGUAGE — executable full-context basis solver
MODULE crack_all.context_crack_exec
IMPORT crack_all.context_v2
IMPORT rmal.meta.solver
EXPORT result,verified,verification_report
SURFACE canonical

CONST request = "{\"bounds\":{\"brute_force_limit\":200000,\"max_plans\":8,\"max_states_per_plan\":300000,\"verification_max_states\":300000},\"problem\":{\"constraints\":[{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_EXECUTION\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_BUILD\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:build\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_ROTATION\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_TRANSFORM_CODEC\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:codec\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_FIELD\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_INVARIANT_COST\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:cost\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_EVIDENCE\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_ETHICS\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:ethics\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_FIELD\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_IDENTITY\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:identity\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_FIELD\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_INVARIANT_COST\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:invariant\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_LINEAGE\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_LIBRARY\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:library\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_ROTATION\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_OBSERVER\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:observer\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_LINEAGE\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_PROVENANCE\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:provenance\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_EXECUTION\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_SEARCH\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:search\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_ROTATION\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_TRANSFORM_CODEC\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:transform\"},{\"expr\":{\"args\":[{\"args\":[{\"var\":\"K_EVIDENCE\"},1],\"op\":\"eq\"},{\"args\":[{\"var\":\"A_VERIFY\"},1],\"op\":\"eq\"}],\"op\":\"or\"},\"name\":\"obligation:verify\"}],\"metadata\":{\"meaning\":\"Smallest declared machinery basis retaining every required processing obligation without merging underlying named systems.\",\"name\":\"Full-context RMAL kernel compression\",\"source_registry_families\":38,\"source_registry_names\":299},\"mode\":\"optimize\",\"objectives\":[{\"expr\":{\"args\":[{\"args\":[3,{\"var\":\"K_FIELD\"}],\"op\":\"mul\"},{\"args\":[3,{\"var\":\"K_ROTATION\"}],\"op\":\"mul\"},{\"args\":[2,{\"var\":\"K_EVIDENCE\"}],\"op\":\"mul\"},{\"args\":[2,{\"var\":\"K_LINEAGE\"}],\"op\":\"mul\"},{\"args\":[2,{\"var\":\"K_EXECUTION\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_IDENTITY\"}],\"op\":\"mul\"},{\"args\":[2,{\"var\":\"A_INVARIANT_COST\"}],\"op\":\"mul\"},{\"args\":[2,{\"var\":\"A_TRANSFORM_CODEC\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_OBSERVER\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_VERIFY\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_ETHICS\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_PROVENANCE\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_LIBRARY\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_SEARCH\"}],\"op\":\"mul\"},{\"args\":[1,{\"var\":\"A_BUILD\"}],\"op\":\"mul\"}],\"op\":\"sum\"},\"name\":\"semantic_cost\",\"priority\":0,\"sense\":\"min\"},{\"expr\":{\"args\":[{\"var\":\"K_FIELD\"},{\"var\":\"K_ROTATION\"},{\"var\":\"K_EVIDENCE\"},{\"var\":\"K_LINEAGE\"},{\"var\":\"K_EXECUTION\"},{\"var\":\"A_IDENTITY\"},{\"var\":\"A_INVARIANT_COST\"},{\"var\":\"A_TRANSFORM_CODEC\"},{\"var\":\"A_OBSERVER\"},{\"var\":\"A_VERIFY\"},{\"var\":\"A_ETHICS\"},{\"var\":\"A_PROVENANCE\"},{\"var\":\"A_LIBRARY\"},{\"var\":\"A_SEARCH\"},{\"var\":\"A_BUILD\"}],\"op\":\"sum\"},\"name\":\"machinery_count\",\"priority\":1,\"sense\":\"min\"}],\"variables\":{\"A_BUILD\":[0,1],\"A_ETHICS\":[0,1],\"A_IDENTITY\":[0,1],\"A_INVARIANT_COST\":[0,1],\"A_LIBRARY\":[0,1],\"A_OBSERVER\":[0,1],\"A_PROVENANCE\":[0,1],\"A_SEARCH\":[0,1],\"A_TRANSFORM_CODEC\":[0,1],\"A_VERIFY\":[0,1],\"K_EVIDENCE\":[0,1],\"K_EXECUTION\":[0,1],\"K_FIELD\":[0,1],\"K_LINEAGE\":[0,1],\"K_ROTATION\":[0,1]}},\"search\":{\"value_orders\":[\"declared\",\"reverse\"],\"variable_orders\":[\"mrv_degree\",\"degree\",\"declared\",\"reverse\"]}}"
LET result = meta.solve_request(request)
LET verified = meta.verify_bundle(request, result)
REQUIRE verified
LET verification_report = meta.verification_report(request, result)