"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"authority":"INTERNAL","bind":"HumanClarityDecision","effect":"READ","inputs":["ClarityState"],"name":"HUMAN_CLARITY_GATE","output":"HumanClarityDecision","preserves":["alternatives","provenance","remainder"],"requires":["consequential_ambiguity"]},"kind":"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"LOOK observes a local surface\"","name":"R_LOOK_CONNECT_01","then":"\"CONNECT only the smallest consequential local relation justified by that observation\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"CONNECT changes a local relation\"","name":"R_LOOK_CONNECT_02","then":"\"the next LOOK observes the consequence of that connection\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"distant information matters\"","name":"R_LOCAL_01","then":"\"carry it through explicit local hops with provenance rather than global broadcast\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"channels are independent\"","name":"R_ASYNC_01","then":"\"do not impose a global synchronization barrier\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"two events have a causal dependency\"","name":"R_ASYNC_02","then":"\"synchronize only the dependent relation\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"concurrent arrivals conflict\"","name":"R_ASYNC_03","then":"\"preserve both traces and route ambiguity to Remainder\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"present observation preserves every consequential distinction\"","name":"R_MEMORY_01","then":"\"do not add richer memory architecture\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"present observation fails a consequential distinction\"","name":"R_MEMORY_02","then":"\"earn the smallest local trace memory sufficient for reconstruction\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"local delta is zero\"","name":"R_HABIT_01","then":"\"stop mutating that locality only\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"another locality remains active\"","name":"R_HABIT_02","then":"\"do not infer global DELTA_ZERO\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"ambiguity is consequential\"","name":"R_HUMAN_01","then":"\"preserve alternatives and require human clarity adjudication\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"ambiguity is not consequential\"","name":"R_HUMAN_02","then":"\"continue without forcing human interruption\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"bindings":{"objective":"cheapest_reconstructible_clear_surface","optimization":"rotate_representation_not_evidence","rejection":"loss_of_provenance_or_ceiling_or_remainder_or_homeward"},"name":"SemanticRotation"},"kind":"CONTEXT","op":"META"},{"op":"SET_LAST"},{"attrs":{"authority":"NONE","bind":"RotationCandidate","effect":"STATE","inputs":["RotationCandidate"],"name":"SEMANTIC_ROTATE","output":"RotationCandidate","preserves":["clarity","provenance","claim_ceiling","remainder","recovery"],"requires":["reconstructible"]},"kind":"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"authority":"NONE","bind":"RotationCandidate","effect":"READ","inputs":["RotationCandidate"],"name":"RECONCILE_ROTATION","output":"RotationCandidate","preserves":["clarity","provenance","claim_ceiling","remainder"],"requires":[]},"kind":"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"a rotated surface is cheaper and reconstructs every protected distinction\"","name":"R_ROTATE_01","then":"\"prefer the rotated surface without strengthening evidence\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"rotation loses provenance, claim ceiling, remainder, or recovery\"","name":"R_ROTATE_02","then":"\"reject it\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"two frames differ\"","name":"R_ROTATE_03","then":"\"reconcile frames before semantic comparison\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"bindings":{"carrier":"BRL_torsion_style_reversible_output","compare":"reconcile_first","phase_modulus":"128","reflection":"BBF_coordinate_reflection","return":"Homeward_exact","sector_0_rate":"+1","sector_1_rate":"-1","sector_2_rate":"+3","sector_3_rate":"0_fixed"},"name":"TorsionOutput"},"kind":"CONTEXT","op":"META"},{"op":"SET_LAST"},{"attrs":{"authority":"NONE","bind":"TorsionFrame","effect":"STATE","inputs":["TorsionFrame"],"name":"TORSION_ROTATE","output":"TorsionFrame","preserves":["clarity","provenance","path","fixed_sector","remainder"],"requires":["reversible_frame"]},"kind":"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"authority":"NONE","bind":"TorsionFrame","effect":"STATE","inputs":["TorsionFrame"],"name":"BBF_REFLECT","output":"TorsionFrame","preserves":["clarity","provenance","path","fixed_sector"],"requires":["reversible_frame"]},"kind":"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"authority":"NONE","bind":"TorsionFrame","effect":"READ","inputs":["TorsionFrame"],"name":"RECONCILE_FRAME","output":"TorsionFrame","preserves":["clarity","provenance","source_relation"],"requires":[]},"kind":"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"authority":"NONE","bind":"TorsionFrame","effect":"STATE","inputs":["TorsionFrame"],"name":"HOMEWARD","output":"TorsionFrame","preserves":["clarity","provenance","source_relation","trace"],"requires":["inverse_path"]},"kind":"OPERATOR_DEF","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"two torsion outputs are compared\"","name":"R_TORSION_01","then":"\"reconcile both to a common frame before comparison\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"a torsion view scores better\"","name":"R_TORSION_02","then":"\"do not infer stronger identity, truth, or evidence from the score\""},"kind":"RULE","op":"META"},{"op":"SET_LAST"},{"attrs":{"if":"\"outward motion completes\"","name":"R_TORSIO