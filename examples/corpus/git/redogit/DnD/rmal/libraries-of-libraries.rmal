PROTOCOL BidirectionalHandoffPairity {
    state = COORDINATION_CONTRACT_ONLY
    marker = BidirectionalHandoffPairity_2026_09_20

    REQUEST {
        handoff_id
        from
        to
        subject_uid
        goal
        obligation
        request_class
        requested_action
        source_refs[]
        evidence_refs[]
        privacy
        claim_ceiling
        unresolved[]
        way_back[]
    }

    RESPONSE {
        response_id
        in_reply_to
        from
        to
        status { ACCEPTED REJECTED NEEDS_EVIDENCE UNRESOLVED }
        decision_reason
        successor_refs[]
        evidence_refs[]
        unresolved[]
        privacy
        claim_ceiling
        way_back[]
    }

    FORWARD {
        A -> REQUEST -> B
        B -> TARGET_LOCAL_DECISION -> RESPONSE -> A
    }

    REVERSE {
        B -> REQUEST -> A
        A -> TARGET_LOCAL_DECISION -> RESPONSE -> B
    }

    COUNTERPROPOSAL {
        REQUIRE NEW_HANDOFF_ID
        PRESERVE PRIOR_REQUEST
        PRESERVE PRIOR_RESPONSE
    }

    PRIVACY {
        MAY_PRESERVE
        MAY_STRENGTHEN
        MAY_NOT_WEAKEN_WITHOUT_INDEPENDENT_TARGET_REGROUNDING
    }

    RULE {
        REQUEST != COMMAND
        RESPONSE != AUTHORITY_TRANSFER
        ACCEPTED != VERIFIED
        REJECTED != FAILURE
        NEEDS_EVIDENCE != REJECTED
        UNRESOLVED != FALSE
        REFERENCE != EVIDENCE_TRANSFER
        PRIVATE_SOURCE_MUST_NOT_PROPAGATE
        AUTHORIZED_READ != PUBLICATION_PERMISSION
        LIBRARIES_OF_LIBRARIES_REFERENCE != TARGET_IMPLEMENTATION_AUTHORITY
    }
}

