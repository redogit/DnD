LAW ResearchIsolation {
    METHOD_TRANSFER = ALLOWED
    TOOLING_TRANSFER = ALLOWED
    PROVENANCE_SCHEMA_TRANSFER = ALLOWED

    CONCLUSION_TRANSFER = DENY_UNLESS_EARNED
    PROOF_TRANSFER = DENY_UNLESS_EARNED
    EMPIRICAL_RESULT_TRANSFER = DENY_UNLESS_EARNED
    AUTHORITY_TRANSFER = DENY
}

ADAPTER Git {
    ROLE chronology provenance action_history

    RULE {
        GIT_HEAD != TOTAL_HISTORY
        CURRENT_FILE != ORIGINAL_THOUGHT
        COMMIT != TRUTH
    }
}

LOOP Runtime {
    Human
    -> Goal
    -> Obligation
    -> Field
    -> Difference
    -> FightingPoint
    -> ConsequentialDistinction
    -> DecisionField
    -> Ma
    -> Orbit
    -> LibraryOfLibraries
    -> SmallestRelevantLineage
    -> Airlock
    -> Operators
    -> Transform
    -> Verify
    -> GSFL
    -> HumanSurface
    -> Action
    -> Observation
    -> Witness
    -> LearnedDelta
    -> Git
    -> ReconstructionSeed
    -> ReleaseReconstructibleWeight
    -> NextGoal
}

LAW WayBack {
    KEEP {
        human
        goal
        identity
        distinction
        provenance
        evidence
        uncertainty
        failure
        recovery_relation
        way_back
    }

    NEVER_SQUASH_AWAY {
        conflicting_evidence
        independent_identity
        negative_result
        chronology
        privacy_boundary
        claim_ceiling
        unresolved_remainder
    }
}


SYSTEM USDAY {
    STATE DESIGN_ONLY

    ORDER {
        JUST_LOAD_IT
        -> UNDERSTAND
        -> PLAN
        -> PAIRITY
        -> SHARED_DECISION_IF_REQUIRED
        -> DO
        -> OBSERVE
        -> COUNTERPROBE
        -> CHECK
        -> RETAIN
        -> SOLDAY_CARRY
        -> RMADAY_RECORD_RECONSTRUCT
        -> CONTINUE
    }

    RULE {
        US != MERGED
        COOPERATION != OBEDIENCE
        AGREEMENT != EVIDENCE
        CONSENSUS != TRUTH
        DISAGREEMENT != FAILURE
    }
}

ENTITY PairityCheck {
    participant_a
    participant_b
    relation_a_to_b
    relation_b_to_a
    invariants[]
    differences[]
    mismatches[]
    parity_if_earned?
}

RULE Pairity {
    PAIRITY != FORCED_EQUALITY
}

ENTITY AgreementField {
    source_expressions[]
    participants[]
    interpretations[]
    relations[]
    agreements[]
    disagreements[]
    evidence[]
    goal
    unresolved[]
}

SYSTEM InterlinguaLinguisticsAgreementSystem {
    STATE DESIGN_ONLY

    INPUT AgreementField

    PROCESS {
        preserve_source_native
        identify_consequential_terms
        generate_candidate_interpretations
        rotate_representation_if_useful
        pairity_check
        preserve_disagreement
        state_agreement
        state_unresolved
    }

    RULE {
        AGREEMENT != SAME_WORDS
        LEXICAL_MATCH != OPERATIONAL_AGREEMENT
        LEXICAL_DIFFERENCE != OPERATIONAL_DISAGREEMENT
        TRANSLATION != IDENTITY
        INTERPRETATION != SOURCE
        UNDERSTOOD != CONSENTED
        AGREED_MEANING != AGREED_ACTION
    }
}

LAW PrivateHistory {
    PRIVATE_HISTORY != PUBLIC_EVIDENCE
    PRIVATE_HISTORY != PROJECT_ARTIFACT
    LANGUAGE_PATTERN != PERSONAL_PROFILE
    LEARNED_METHOD != DISCLOSURE
    DERIVED_FROM_PRIVATE_HISTORY != SAFE_TO_PUBLISH

    OP LearnMethod(private_history) {
        method := ExtractAbstractProblemSolvingStructure(private_history)
        method := RemovePrivateFactsAndIdentityBearingDetail(method)
        RETAIN_INTERNAL method
        RETURN method
    }

    ADMISSION public_candidate {
        IF derived_from_private_history == TRUE
            FAIL_CLOSED
    }

    RULE {
        SANITIZED_PRIVATE_NARRATIVE != PUBLIC_SOURCE
        PROJECT_CLAIM_REQUIRES current_authorized_project_evidence
    }
}

PROTOCOL CooperativeImplementation {
    design_authority = RYAN_MCMILLAN
    implementation_relation = HUMAN_AI_COIMPLEMENTATION
    cross_write_default = DENY
    evidence_transfer_default = DENY

    FLOW {
        REFERENCE
        -> PROPOSAL
        -> HANDOFF
        -> TARGET_DECISION
        -> TARGET_LOCAL_SUCCESSOR
    }

    RULE {
        RELATED != AUTHORIZED_TO_EDIT
        READ != WRITE
        PROPOSED != ACCEPTED
        ACCEPTED != VERIFIED
        SHARED_METHOD != SHARED_EVIDENCE
        SUCCESSOR != REWRITTEN_PREDECESSOR
    }
}

